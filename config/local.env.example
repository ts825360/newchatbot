# Optional integrations. Copy needed settings to an ignored .env.local.
# Never put a credential in this versioned example or in a NEXT_PUBLIC_ setting.

# Keep integrations off until explicitly configured.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=

# Google OAuth for the loopback Docker address. Change both URLs on an HTTPS host.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3020
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3020/api/integrations/google/callback
# Server-only keys. The browser map embed key, if used, must be separately restricted.
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Optional public mailbox, compiled into the browser UI. Do not use private email.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Server-only issue notification configuration. Independent of the public mailbox.
RESEND_API_KEY=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=

# Optional Compose overrides (defaults are already defined in compose.yaml).
# CHURCH_IMAGE=nowchatbot:v0.2.0-rc.25
# CHURCH_BIND_IP=127.0.0.1
# CHURCH_PORT=3020
